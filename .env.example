# Copier en .env et remplir.

# --- OAuth (client Web, consent screen Interne, scopes drive.file + spreadsheets) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à un redirect URI déclaré dans le client OAuth.
# Local : http://localhost:8080/oauth/callback
# Cloud Run : https://<service>-<hash>.europe-west1.run.app/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# --- Firestore (stockage tokens + ids par user) ---
GOOGLE_CLOUD_PROJECT=avisia-training

# Local uniquement : ADC pour Firestore (sinon `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/adc.json
